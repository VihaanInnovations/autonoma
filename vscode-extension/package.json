{
    "name": "autonoma-ai-engine",
    "displayName": "Autonoma AI - Local Autonomous Code Fixing Agent",
    "description": "Local autonomous code fixing agent. Fixes bugs while you sleep. Air-gapped & Secure.",
    "version": "1.0.4",
    "publisher": "autonoma-team",
    "icon": "icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/vihaaninnovations/autonoma"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Machine Learning"
    ],
    "keywords": [
        "code review",
        "ai",
        "lint",
        "security",
        "privacy",
        "local"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "autonoma.analyze",
                "title": "Autonoma: Analyze File"
            },
            {
                "command": "autonoma.analyzeProject",
                "title": "Autonoma: Analyze Project"
            },
            {
                "command": "autonoma.runProjectAnalysis",
                "title": "Autonoma: Run Project Analysis"
            }
        ],
        "configuration": {
            "title": "Autonoma Configuration",
            "properties": {
                "autonoma.enableLocalLLM": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable local LLM inference."
                },
                "autonoma.localModel": {
                    "type": "string",
                    "default": "llama3",
                    "description": "Model name for Local LLM (e.g. llama3, mistral)."
                },
                "autonoma.disabledRules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of rule IDs to disable (e.g. ['PY001', 'SEC002'])."
                },
                "autonoma.modelPreference": {
                    "type": "string",
                    "enum": [
                        "local",
                        "auto"
                    ],
                    "default": "local",
                    "description": "Preference for LLM backend."
                },
                "autonoma.ruleOverrides": {
                    "type": "object",
                    "default": {},
                    "description": "Rule overrides."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npx tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.90.0",
        "@vscode/test-electron": "^2.3.9",
        "@vscode/vsce": "^3.7.1",
        "glob": "^10.3.10",
        "mocha": "^10.2.0",
        "ts-loader": "^9.0.0",
        "typescript": "^5.0.0",
        "webpack": "^5.0.0",
        "webpack-cli": "^5.0.0"
    },
    "dependencies": {
        "axios": "^1.0.0"
    }
}